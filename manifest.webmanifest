    {"name": "Week", "url": "./?view=week", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "History", "url": "./?view=history", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ]
